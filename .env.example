# İzletiriz — environment variables
#
# All AI features work WITHOUT keys using offline/browser fallbacks. Set keys
# to enable real AI. On Vercel: Project Settings → Environment Variables.

# --- OpenRouter (preferred for text/script, OpenAI-compatible) ---------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides:
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
OPENROUTER_SITE_URL=https://izletiriz.vercel.app

# --- OpenAI (fallback for text/image; REQUIRED for AI voice-over/TTS) --------
# OpenRouter has no speech endpoint, so real AI narration needs this key.
OPENAI_API_KEY=
